@model NailBook.ViewModels.Admin.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-dashboard-hero text-center mb-4">
    <h1>Admin Dashboard</h1>
    <p class="lead mb-0">Welcome, @User.Identity?.Name!</p>
</div>

<div class="row justify-content-center mb-4">
    <div class="col-md-3 mb-3">
        <div class="card dashboard-stat-card h-100">
            <div class="card-body">
                <h2 class="display-6">@Model.PendingAppointmentsCount</h2>
                <p class="mb-0">Pending appointments</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card dashboard-stat-card h-100">
            <div class="card-body">
                <h2 class="display-6">@Model.CompletedAppointmentsCount</h2>
                <p class="mb-0">Completed appointments</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card dashboard-stat-card h-100">
            <div class="card-body">
                <h2 class="display-6">@Model.ActiveServicesCount</h2>
                <p class="mb-0">Active services</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center gap-2 flex-wrap mb-4">
    <a asp-area="Admin"
       asp-controller="Appointments"
       asp-action="Index"
       class="btn btn-primary">
        Manage Appointments
    </a>

    <a asp-area="Admin"
       asp-controller="Services"
       asp-action="Index"
       class="btn btn-outline-primary">
        Manage Services
    </a>

    <a asp-area="Admin"
       asp-controller="NailDesigns"
       asp-action="Index"
       class="btn btn-outline-primary">
        Manage Gallery
    </a>

    <a asp-area="Admin"
       asp-controller="Reviews"
       asp-action="Index"
       class="btn btn-outline-primary">
        Manage Reviews
    </a>
</div>

<div class="dashboard-upcoming-card">
    <h2 class="h3 mb-3">Upcoming Appointments</h2>

    @if (!Model.UpcomingAppointments.Any())
    {
        <p class="mb-0">No upcoming appointments.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                <tr>
                    <th>Date and time</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Status</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var appointment in Model.UpcomingAppointments)
                {
                    <tr>
                        <td>@appointment.AppointmentDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@(appointment.Customer.FullName ?? appointment.Customer.Email)</td>
                        <td>@appointment.Service.Name</td>
                        <td>
                            @if (appointment.Status == NailBook.Models.Enums.AppointmentStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (appointment.Status == NailBook.Models.Enums.AppointmentStatus.Confirmed)
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else if (appointment.Status == NailBook.Models.Enums.AppointmentStatus.Cancelled)
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Completed</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
