@model IEnumerable<NailBook.Models.Appointment>

@{
    ViewData["Title"] = "Manage Appointments";
    var selectedStatus = Context.Request.Query["status"].ToString();
    var selectedDate = Context.Request.Query["date"].ToString();
}

<div class="admin-appointments-hero text-center mb-4">
    <h1>Appointment Requests</h1>
    <p class="lead mb-0">Review, confirm, or cancel customer requests.</p>
    <form method="get" class="row justify-content-center mt-3">
        <div class="col-md-4">
            <select name="status"
                    asp-items="ViewBag.Statuses"
                    class="form-select">
                <option value="">All statuses</option>
            </select>
        </div>

        <div class="col-md-3 mt-2 mt-md-0">
            <input type="date"
                   name="date"
                   value="@selectedDate"
                   class="form-control"
                   aria-label="Filter by date" />
        </div>

        <div class="col-md-auto mt-2 mt-md-0">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="admin-appointments-card">
    @if (!Model.Any())
    {
        <p class="mb-0">No appointment requests have been made yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                <tr>
                    <th>Date and time</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Note</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var appointment in Model)
                {
                    <tr>
                        <td>@appointment.AppointmentDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@(appointment.Customer.FullName ?? appointment.Customer.Email)</td>
                        <td>@appointment.Service.Name</td>
                        <td>@appointment.CustomerNote</td>
                        <td>
                            @if (appointment.Status == NailBook.Models.Enums.AppointmentStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (appointment.Status == NailBook.Models.Enums.AppointmentStatus.Confirmed)
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                        </td>
                        <td>
                            @if (appointment.Status == NailBook.Models.Enums.AppointmentStatus.Pending)
                            {
                                <form asp-action="Confirm"
                                      asp-route-id="@appointment.Id"
                                      method="post"
                                      class="d-inline">
                                    <input type="hidden"
                                           name="status"
                                           value="@selectedStatus" />
                                    <input type="hidden"
                                           name="date"
                                           value="@selectedDate" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        Confirm
                                    </button>
                                </form>
                            }

                            @if (appointment.Status != NailBook.Models.Enums.AppointmentStatus.Cancelled)
                            {
                                <form asp-action="Cancel"
                                      asp-route-id="@appointment.Id"
                                      method="post"
                                      class="d-inline">
                                    <input type="hidden"
                                           name="status"
                                           value="@selectedStatus" />
                                    <input type="hidden"
                                           name="date"
                                           value="@selectedDate" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Cancel
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
