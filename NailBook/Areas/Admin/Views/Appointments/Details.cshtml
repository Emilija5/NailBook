@model NailBook.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
    var selectedStatus = Context.Request.Query["status"].ToString();
    var selectedDate = Context.Request.Query["date"].ToString();
}

<h1>Appointment Details</h1>

<dl class="row">
    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@(Model.Customer.FullName ?? "Not provided")</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Customer.Email</dd>

    <dt class="col-sm-3">Service</dt>
    <dd class="col-sm-9">@Model.Service.Name</dd>

    <dt class="col-sm-3">Date and time</dt>
    <dd class="col-sm-9">@Model.AppointmentDateTime.ToString("dd MMM yyyy HH:mm")</dd>

    <dt class="col-sm-3">Customer note</dt>
    <dd class="col-sm-9">@(Model.CustomerNote ?? "No note provided.")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.Status == NailBook.Models.Enums.AppointmentStatus.Pending)
        {
            <span class="badge bg-warning text-dark">Pending</span>
        }
        else if (Model.Status == NailBook.Models.Enums.AppointmentStatus.Confirmed)
        {
            <span class="badge bg-success">Confirmed</span>
        }
        else if (Model.Status == NailBook.Models.Enums.AppointmentStatus.Cancelled)
        {
            <span class="badge bg-danger">Cancelled</span>
        }
        else
        {
            <span class="badge bg-primary">Completed</span>
        }
    </dd>

    <dt class="col-sm-3">Inspiration image</dt>
    <dd class="col-sm-9">
        @if (Model.InspirationImage is not null)
        {
            <a href="@Model.InspirationImage.ImageUrl" target="_blank" rel="noopener">
                <img src="@Model.InspirationImage.ImageUrl"
                     alt="Customer inspiration"
                     class="img-fluid rounded"
                     style="max-width: 320px;" />
            </a>
        }
        else
        {
            <span>No inspiration image provided.</span>
        }
    </dd>
</dl>

<a asp-action="Index"
   asp-route-status="@selectedStatus"
   asp-route-date="@selectedDate"
   class="btn btn-secondary">
    Back to Appointments
</a>
