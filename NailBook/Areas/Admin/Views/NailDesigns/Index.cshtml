@model IEnumerable<NailBook.Models.NailDesign>

@{
    ViewData["Title"] = "Manage Gallery";
}

<h1>Manage Gallery</h1>

@if (!Model.Any())
{
    <p>No nail designs have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Title</th>
            <th>Style</th>
            <th>Created</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var design in Model)
        {
            <tr>
                <td>@design.Title</td>
                <td>@design.Style</td>
                <td>@design.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
            </tr>
        }
        </tbody>
    </table>
}