@model IEnumerable<NailBook.Models.NailDesign>

@{
    ViewData["Title"] = "Manage Gallery";
}

<h1>Manage Gallery</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Add Nail Design</a>
</p>

@if (!Model.Any())
{
    <p>No nail designs have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Style</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var design in Model)
        {
            <tr>
                <td>
                    <img src="@design.ImageUrl"
                         alt="@design.Title"
                         class="img-thumbnail"
                         style="width: 100px; height: 100px; object-fit: cover;" />
                </td>
                <td>@design.Title</td>
                <td>@design.Style</td>
                <td>@design.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@design.Id"
                       class="btn btn-sm btn-outline-primary">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}