@model NailBook.ViewModels.Appointments.CreateAppointmentViewModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Book Appointment";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="booking-card">
            <div class="booking-hero text-center">
                <h1>Book Appointment</h1>
                <p class="lead mb-0">
                    Choose your preferred service, date, and time.
                </p>
            </div>

            <div class="booking-content">
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success">
                        @successMessage
                    </div>
                }

                <div class="booking-help">
                    <h2 class="h5">How booking works</h2>
                    <ol class="mb-0">
                        <li>Choose an active service, date, and time.</li>
                        <li>Send your appointment request.</li>
                        <li>Your request starts as Pending.</li>
                        <li>The salon admin will confirm or cancel it.</li>
                    </ol>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="ServiceId" class="form-label">Service</label>
                        <select asp-for="ServiceId"
                                asp-items="ViewBag.Services"
                                class="form-select">
                            <option value="">-- Choose a service --</option>
                        </select>
                        <span asp-validation-for="ServiceId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AppointmentDate" class="form-label">
                            Preferred date
                        </label>
                        <input asp-for="AppointmentDate"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control" />
                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AppointmentTime" class="form-label">
                            Preferred time
                        </label>
                        <select asp-for="AppointmentTime"
                                asp-items="ViewBag.AppointmentTimes"
                                class="form-select">
                            <option value="">-- Choose a time --</option>
                        </select>
                        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                        <div id="availableTimesMessage" class="form-text">
                            Choose a service and date to see available times.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerNote" class="form-label">
                            Note (optional)
                        </label>
                        <textarea asp-for="CustomerNote" class="form-control"></textarea>
                        <span asp-validation-for="CustomerNote" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InspirationImageFile" class="form-label">
                            Inspiration image (optional)
                        </label>
                        <input asp-for="InspirationImageFile"
                               type="file"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="form-control" />
                        <div class="form-text">
                            JPG, PNG, or WEBP. Maximum size: 5 MB.
                        </div>
                        <span asp-validation-for="InspirationImageFile" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Request Appointment
                    </button>

                    <a asp-controller="Services"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const serviceSelect = document.getElementById("ServiceId");
        const appointmentDateInput = document.getElementById("AppointmentDate");
        const appointmentTimeSelect = document.getElementById("AppointmentTime");
        const availableTimesMessage = document.getElementById("availableTimesMessage");
        const availableTimesUrl = "@Url.Action("AvailableTimes", "Appointments")";

        function addTimePlaceholder(text) {
            appointmentTimeSelect.innerHTML = "";

            const option = document.createElement("option");
            option.value = "";
            option.textContent = text;
            appointmentTimeSelect.appendChild(option);
        }

        async function updateAvailableTimes(keepSelectedTime) {
            const serviceId = serviceSelect.value;
            const appointmentDate = appointmentDateInput.value;
            const selectedTime = keepSelectedTime
                ? appointmentTimeSelect.value
                : "";

            if (!serviceId || !appointmentDate) {
                addTimePlaceholder("-- Choose a service and date first --");
                appointmentTimeSelect.disabled = true;
                availableTimesMessage.textContent =
                    "Choose a service and date to see available times.";
                return;
            }

            addTimePlaceholder("Loading available times...");
            appointmentTimeSelect.disabled = true;

            try {
                const response = await fetch(
                    `${availableTimesUrl}?serviceId=${encodeURIComponent(serviceId)}&appointmentDate=${encodeURIComponent(appointmentDate)}`);

                if (!response.ok) {
                    throw new Error("Could not load available times.");
                }

                const availableTimes = await response.json();
                addTimePlaceholder("-- Choose a time --");

                for (const time of availableTimes) {
                    const option = document.createElement("option");
                    option.value = time;
                    option.textContent = time;
                    appointmentTimeSelect.appendChild(option);
                }

                if (availableTimes.includes(selectedTime)) {
                    appointmentTimeSelect.value = selectedTime;
                }

                appointmentTimeSelect.disabled = availableTimes.length === 0;
                availableTimesMessage.textContent = availableTimes.length === 0
                    ? "No times are available for this service and date."
                    : "Only available times are shown.";
            } catch {
                addTimePlaceholder("-- Could not load times --");
                appointmentTimeSelect.disabled = true;
                availableTimesMessage.textContent =
                    "Available times could not be loaded. Please try again.";
            }
        }

        serviceSelect.addEventListener("change", () => updateAvailableTimes(false));
        appointmentDateInput.addEventListener("change", () => updateAvailableTimes(false));

        updateAvailableTimes(true);
    </script>
}
