@model NailBook.ViewModels.Appointments.CreateAppointmentViewModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Book Appointment";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="booking-card">
            <div class="booking-hero text-center">
                <h1>Book Appointment</h1>
                <p class="lead mb-0">
                    Choose your preferred service, date, and time.
                </p>
            </div>

            <div class="booking-content">
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success">
                        @successMessage
                    </div>
                }

                <div class="booking-help">
                    <h2 class="h5">How booking works</h2>
                    <ol class="mb-0">
                        <li>Choose an active service, date, and time.</li>
                        <li>Send your appointment request.</li>
                        <li>Your request starts as Pending.</li>
                        <li>The salon admin will confirm or cancel it.</li>
                    </ol>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="ServiceId" class="form-label">Service</label>
                        <select asp-for="ServiceId"
                                asp-items="ViewBag.Services"
                                class="form-select">
                            <option value="">-- Choose a service --</option>
                        </select>
                        <span asp-validation-for="ServiceId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AppointmentDate" class="form-label">
                            Preferred date
                        </label>
                        <input asp-for="AppointmentDate"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control" />
                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AppointmentTime" class="form-label">
                            Preferred time
                        </label>
                        <select asp-for="AppointmentTime"
                                asp-items="ViewBag.AppointmentTimes"
                                class="form-select">
                            <option value="">-- Choose a time --</option>
                        </select>
                        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                        <div class="form-text">
                            Appointments are available from 08:00 to 18:00.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerNote" class="form-label">
                            Note (optional)
                        </label>
                        <textarea asp-for="CustomerNote" class="form-control"></textarea>
                        <span asp-validation-for="CustomerNote" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InspirationImageFile" class="form-label">
                            Inspiration image (optional)
                        </label>
                        <input asp-for="InspirationImageFile"
                               type="file"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="form-control" />
                        <div class="form-text">
                            JPG, PNG, or WEBP. Maximum size: 5 MB.
                        </div>
                        <span asp-validation-for="InspirationImageFile" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Request Appointment
                    </button>

                    <a asp-controller="Services"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
