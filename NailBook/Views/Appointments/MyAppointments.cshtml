@model IEnumerable<NailBook.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<h1>My Appointments</h1>
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Request Appointment</a>
</p>

@if (!Model.Any())
{
    <p>You have not requested any appointments yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Date and time</th>
            <th>Service</th>
            <th>Note</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var appointment in Model)
        {
            <tr>
                <td>@appointment.AppointmentDateTime.ToString("dd MMM yyyy HH:mm")</td>
                <td>@appointment.Service.Name</td>
                <td>@appointment.CustomerNote</td>
                <td>@appointment.Status</td>
                <td>
                    @if (appointment.Status == NailBook.Models.Enums.AppointmentStatus.Pending)
                    {
                        <form asp-action="Cancel"
                              asp-route-id="@appointment.Id"
                              method="post"
                              class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Cancel this appointment request?');">
                                Cancel
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}