@model IEnumerable<NailBook.Models.NailDesign>

@{
    ViewData["Title"] = "Gallery";
}

<div class="gallery-hero text-center mb-5">
    <h1>Nail Design Gallery</h1>
    <p class="lead mb-0">Explore our latest nail designs.</p>
</div>

@if (!Model.Any())
{
    <p>No nail designs have been added yet.</p>
}
else
{
    <div class="row">
        @foreach (var design in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card gallery-card h-100">
                    <img src="@design.ImageUrl"
                         alt="@design.Title"
                         class="card-img-top gallery-image" />

                    <div class="card-body">
                        <h5 class="card-title">@design.Title</h5>
                        <p class="card-text">
                            <strong>Style:</strong> @design.Style
                        </p>

                        @if (!string.IsNullOrWhiteSpace(design.Description))
                        {
                            <p class="card-text">@design.Description</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}