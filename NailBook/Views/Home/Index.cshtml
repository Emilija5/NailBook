@{
    ViewData["Title"] = "Home";
}

<div class="home-hero text-center py-5">
    <h1 class="display-4">Welcome to NailBook</h1>
    <p class="lead">
        Discover nail services, explore designs, and request your appointment.
    </p>

    <div class="d-flex justify-content-center gap-2 flex-wrap mt-4">
        <a asp-controller="Services"
           asp-action="Index"
           class="btn btn-primary">
            View Services
        </a>

        <a asp-controller="Gallery"
           asp-action="Index"
           class="btn btn-outline-primary">
            View Gallery
        </a>

        @if (User.IsInRole(RoleNames.Customer))
        {
            <a asp-controller="Appointments"
               asp-action="Create"
               class="btn btn-success">
                Request Appointment
            </a>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-area="Identity"
               asp-page="/Account/Login"
               class="btn btn-success">
                Sign in to Book
            </a>
        }
    </div>
</div>
<section class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card home-card">
            <div class="card-body">
                <h2 class="h3">About NailBook</h2>
                <p>
                    NailBook helps you explore nail services and designs,
                    then request an appointment online.
                </p>
                <p class="mb-0">
                    Choose your preferred service, date, and time.
                    The salon will review your request and confirm it.
                </p>
            </div>
        </div>
    </div>
</section>
<section class="row justify-content-center mt-4">
    <div class="col-lg-8">
        <div class="card home-card">
            <div class="card-body">
                <h2 class="h3">Contact</h2>
                <p>
                    Phone:
                    <a href="tel:+38970123456">+389 70 123 456</a>
                </p>
                <p>
                    Email:
                    <a href="mailto:hello@nailbook.example">
                        hello@nailbook.example
                    </a>
                </p>
                <p class="mb-0">
                    Address: Skopje, North Macedonia
                </p>
            </div>
        </div>
    </div>
</section>
<section class="home-faq row justify-content-center mt-4">
    <div class="col-lg-8">
        <h2 class="h3 mb-3">Frequently Asked Questions</h2>

        <div class="accordion" id="faqAccordion">
            <div class="accordion-item">
                <h3 class="accordion-header" id="faqBookingHeading">
                    <button class="accordion-button"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#faqBooking">
                        How does booking work?
                    </button>
                </h3>
                <div id="faqBooking"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Choose a service, date, and time. Your request starts
                        as Pending until the salon confirms or cancels it.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h3 class="accordion-header" id="faqCancelHeading">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#faqCancel">
                        Can I cancel an appointment request?
                    </button>
                </h3>
                <div id="faqCancel"
                     class="accordion-collapse collapse"
                     data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Yes. You can cancel your own appointment while its
                        status is Pending.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h3 class="accordion-header" id="faqHoursHeading">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#faqHours">
                        What are the salon hours?
                    </button>
                </h3>
                <div id="faqHours"
                     class="accordion-collapse collapse"
                     data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Appointment requests are available Monday to Saturday,
                        from 08:00 to 18:00. The salon is closed on Sundays.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>